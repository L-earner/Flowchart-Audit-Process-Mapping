# Copy to .env (or set as Replit secrets) and fill in the key(s) you want.
# You need a key for whichever provider's model you select in the UI.

# For Claude models (claude-opus-4-8, claude-sonnet-4-6):
ANTHROPIC_API_KEY=

# For open-source models via OpenRouter (DeepSeek, Llama, Qwen, Mistral, …):
OPENROUTER_API_KEY=

# Optional overrides:
# LLM_MODEL=deepseek/deepseek-chat   # default model when none is selected
# PORT=3001
# DB_PATH=./diagrams.db
