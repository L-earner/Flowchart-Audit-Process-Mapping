# Copy to .env (or set as Replit secrets) and fill in the key(s) you want.
# You need a key for whichever provider's model you select in the UI.

# For Google Gemini models (default: gemini-3.8-flash). Create a key at
# https://aistudio.google.com/apikey. GOOGLE_API_KEY is accepted as an alternative name.
GEMINI_API_KEY=

# For open-source models via OpenRouter (DeepSeek, Llama, Qwen, Mistral, …):
OPENROUTER_API_KEY=

# Optional overrides:
# LLM_MODEL=deepseek/deepseek-chat   # default model when none is selected
# PORT=3001
# DB_PATH=./diagrams.db

# Public read-only demo: disables saving, deleting, and AI extraction
# (returns 403 on those routes regardless of whether API keys are set).
# DEMO_MODE=true
