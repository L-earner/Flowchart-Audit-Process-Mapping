  "graph": {
    "title": "Purchase-to-Pay (Demo)",
    "summary": "Requisition through to payment, with key approval, validation, and three-way-match controls.",
    "actors": [
      { "id": "requester", "name": "Requester" },
      { "id": "manager", "name": "Cost-Centre Manager" },
