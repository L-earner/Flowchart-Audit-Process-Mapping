      { "id": "create_po", "type": "process", "label": "Create & issue PO", "actorId": "procurement", "description": "Procurement converts the requisition into a purchase order and sends it to the vendor." },
      { "id": "po_check", "type": "control", "label": "PO value check", "actorId": "erp", "description": "System verifies PO value is within the approved requisition amount before dispatch.", "control": { "controlType": "automated", "riskAddressed": "PO / requisition value mismatch", "frequency": "Per PO" } },
      { "id": "goods_receipt", "type": "process", "label": "Record goods receipt", "actorId": "procurement", "description": "Receiving team records goods receipt in the ERP on delivery." },
      { "id": "three_way", "type": "control", "label": "Three-way match", "actorId": "ap_clerk", "description": "AP clerk matches purchase order, goods receipt and invoice.", "control": { "controlType": "detective", "riskAddressed": "Paying for goods not received or at the wrong price", "frequency": "Per invoice" } },
      { "id": "match?", "type": "decision", "label": "Match OK?", "actorId": "ap_clerk" },
      { "id": "park_invoice", "type": "process", "label": "Park & investigate", "actorId": "procurement", "description": "Discrepant invoice is parked and sent to procurement to investigate." },
      { "id": "post_invoice", "type": "process", "label": "Post invoice for payment", "actorId": "ap_clerk" },
      { "id": "payment_run", "type": "system", "label": "Weekly payment run", "actorId": "payments", "description": "Payments team settles the invoice in the scheduled run." },
      { "id": "end", "type": "end", "label": "Invoice paid", "actorId": null }
