      { "id": "ap_clerk", "name": "AP Clerk" },
      { "id": "payments", "name": "Payments Team" }
    ],
    "nodes": [
      { "id": "start", "type": "start", "label": "Need identified", "actorId": null },
      { "id": "raise_req", "type": "process", "label": "Raise purchase requisition", "actorId": "requester", "description": "Requester enters vendor, line items, quantities and cost centre in the ERP." },
      { "id": "approve_req", "type": "control", "label": "Approve requisition", "actorId": "manager", "description": "Manager reviews requisition against department budget.", "control": { "controlType": "preventive", "riskAddressed": "Unauthorised or over-budget spend", "frequency": "Per requisition" } },
      { "id": "approved?", "type": "decision", "label": "Approved?", "actorId": "manager" },
