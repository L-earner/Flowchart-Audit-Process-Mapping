modules = ["nodejs-22"]
run = "npm run build && npm start"
[agent]
expertMode = true

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 3097
externalPort = 4200

[[ports]]
localPort = 3098
externalPort = 3003

[[ports]]
localPort = 3099
externalPort = 3001

[[ports]]
localPort = 4317
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5199
externalPort = 3002

[deployment]
deploymentTarget = "cloudrun"
build = "npm run build"
run = "npm start"
